---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
---

<Layout title="Page not found | ICM" noindex>
  <Header />
  <main class="mx-auto max-w-[1200px] px-6 py-24">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 font-display text-[clamp(36px,5vw,60px)] font-bold leading-[1.05] tracking-[-0.03em]">
      This page is <span class="rounded-lg bg-accent px-[0.12em]">off the curve</span>.
    </h1>
    <p class="mt-5 max-w-[520px] text-[17px] text-body">The page you are looking for does not exist or has moved.</p>
    <a href={url('/')} class="btn-accent mt-8 inline-flex min-h-12 items-center rounded-xl px-6 py-3.5 text-[15px] no-underline">Back to home</a>
  </main>
  <Footer />
</Layout>
