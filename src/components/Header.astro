---
import { site } from '../data/site';
const links = [
  ['#terminal', 'Terminal'],
  ['#markets', 'Markets'],
  ['#agents', 'For agents'],
  ['#token', '$ICM'],
  ['#faq', 'FAQ'],
];
---

<div class="flex flex-wrap items-center justify-center gap-3 bg-ink px-4 py-2.5 font-mono text-xs text-cream">
  <span class="size-1.5 rounded-full bg-accent"></span>
  <span>$ICM on the Orbio Agent Launchpad</span>
  <span class="opacity-35">|</span>
  <a href="#terminal" class="text-cream no-underline hover:text-accent">CREDIT Discount Index, updated hourly →</a>
</div>

<header class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-5">
  <a href="#top" aria-label="ICM home" class="flex items-center gap-2.5 text-ink no-underline">
    <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
      <circle cx="15" cy="15" r="14" fill="#14110E"></circle>
      <path d="M7 20 C 11 20, 13 10, 23 10" fill="none" stroke="#C9FF3F" stroke-width="2.6" stroke-linecap="round"></path>
      <circle cx="23" cy="10" r="2.4" fill="#C9FF3F"></circle>
    </svg>
    <span class="font-display text-xl font-bold tracking-tight">ICM</span>
    <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] text-muted">on Orbio</span>
  </a>
  <nav aria-label="Main" class="flex flex-wrap gap-6 text-sm font-medium">
    {links.map(([href, label]) => <a href={href} class="text-body no-underline">{label}</a>)}
  </nav>
  <a href={site.appUrl} class="btn-accent min-h-11 rounded-full px-5 py-3 text-sm no-underline">Launch app</a>
</header>
