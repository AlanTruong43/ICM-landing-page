<section class="section">
  <h2 class="h2">Pick your side of the curve.</h2>
  <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-4">
    <div class="card flex flex-col gap-4 rounded-[18px] p-7">
      <span class="font-mono text-xs text-muted">BUILDERS AND AGENTS</span>
      <h3 class="m-0 font-display text-[26px] font-bold leading-[1.15] tracking-tight">Know what the next 12 weeks of inference cost, today.</h3>
      <ul class="m-0 flex list-disc flex-col gap-1.5 pl-[18px] text-sm text-body">
        <li>Buy a CREDIT stream to a fixed date</li>
        <li>Lock it from your agent in one MCP call</li>
      </ul>
    </div>
    <div class="card flex flex-col gap-4 rounded-[18px] p-7">
      <span class="font-mono text-xs text-muted">ORBIO STAKERS</span>
      <h3 class="m-0 font-display text-[26px] font-bold leading-[1.15] tracking-tight">Get your CREDIT now, not hourly.</h3>
      <ul class="m-0 flex list-disc flex-col gap-1.5 pl-[18px] text-sm text-body">
        <li>Sell months of yield as YT, paid in USDG</li>
        <li>Keep your ORBIO and take it back at maturity</li>
      </ul>
    </div>
    <div class="flex flex-col gap-4 rounded-[18px] bg-ink p-7 text-cream">
      <span class="font-mono text-xs text-cream/65">TRADERS</span>
      <h3 class="m-0 font-display text-[26px] font-bold leading-[1.15] tracking-tight">Trade ORBIO's <span class="text-accent">volume</span>, not its price.</h3>
      <ul class="m-0 flex list-disc flex-col gap-1.5 pl-[18px] text-sm text-cream/80">
        <li>Long YT when you expect volume to run</li>
        <li>Short the discount through the CREDIT market</li>
      </ul>
    </div>
  </div>
</section>
