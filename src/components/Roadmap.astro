---
import { roadmap } from '../data/site';
---

<section class="section">
  <h2 class="h2">Roadmap</h2>
  <ol class="m-0 mt-10 grid list-none grid-cols-[repeat(auto-fit,minmax(200px,1fr))] border-t-2 border-ink p-0">
    {roadmap.map((r) => (
      <li class="flex flex-col gap-2 py-5 pr-5">
        <span class:list={['-mt-[27px] size-3 rounded-full border-2 border-ink', r.active ? 'bg-accent' : 'bg-cream']}></span>
        <span class:list={['mt-2 font-mono text-xs', r.active ? 'text-olive' : 'text-muted']}>{r.when}</span>
        <span class="text-base font-semibold">{r.title}</span>
        <span class="text-[13px] text-body">{r.text}</span>
      </li>
    ))}
  </ol>
</section>
