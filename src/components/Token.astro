---
const cards = [
  ['40%', 'Of fees, paid in CREDIT', "Lock $ICM as veICM. Your share of every market's fees arrives as inference you can spend or sell."],
  ['↑ 1h', 'Backing that ticks up hourly', 'Launchpad creator fees stake ORBIO into a timelocked treasury. Backing per $ICM is live on the Terminal.'],
  ['Lock', 'Every agent holds $ICM', 'Agents using Budget Lock or a funding vault keep a license stake. New markets burn $ICM to open.'],
  ['Vote', 'Decide where incentives go', 'veICM points incentives at maturities and agent vaults. Projects that want liquidity court your vote.'],
];
---

<section id="token" class="section">
  <div class="card rounded-3xl p-[clamp(24px,4vw,48px)]">
    <span class="font-mono text-xs text-muted">$ICM</span>
    <h2 class="mt-3 font-display text-[clamp(32px,4.5vw,56px)] font-bold leading-[1.05] tracking-[-0.035em]">
      Hold $ICM. Your AI <span class="rounded-lg bg-accent px-[0.12em]">runs free</span>.
    </h2>
    <p class="mt-4 max-w-[640px] text-[17px] text-body">
      $ICM earns the fees from every ICM market and owns a growing ORBIO stake. Every number below is readable onchain.
    </p>
    <div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
      {cards.map(([big, title, text]) => (
        <div class="rounded-2xl border border-line bg-cream p-5">
          <div class="font-mono text-[28px] text-olive">{big}</div>
          <h3 class="m-0 mt-2 text-[15px] font-semibold">{title}</h3>
          <p class="mt-1.5 text-sm text-body">{text}</p>
        </div>
      ))}
    </div>
    <div class="mt-9">
      <div class="mb-2.5 text-[13px] text-body">Where every protocol fee goes</div>
      <div class="flex h-11 overflow-hidden rounded-xl font-mono text-xs">
        <div class="flex w-[40%] items-center bg-accent px-3 text-ink">40% veICM, in CREDIT</div>
        <div class="flex w-[20%] items-center bg-ink px-3 text-cream">20% burn</div>
        <div class="flex w-[20%] items-center bg-body px-3 text-cream">20% gauges</div>
        <div class="flex w-[20%] items-center bg-[#E6E6E0] px-3 text-ink">20% treasury</div>
      </div>
      <p class="mt-3 text-[13px] text-muted">
        Fair launch on the Orbio Agent Launchpad, paired with ORBIO. Yield comes from fees only, never printed tokens.
      </p>
    </div>
  </div>
</section>
